# OpenAI-Compatible API Example Configuration
# Copy to .env and modify as needed

# 🔧 Core Settings
CSE_DB_URL=sqlite:///state_engine.db
CSE_FEATURE_BATCH=false
CSE_LLM_PROVIDER=openai

# 🤖 Provider Examples - Choose ONE configuration:

# === OpenAI Official ===
OPENAI_API_KEY=sk-your-openai-key-here
# CSE_MODEL=gpt-3.5-turbo

# === vLLM Server ===
# CSE_API_KEY=dummy-key
# CSE_BASE_URL=http://localhost:8000/v1
# CSE_MODEL=microsoft/DialoGPT-medium

# === Ollama ===
# CSE_API_KEY=dummy-key
# CSE_BASE_URL=http://localhost:11434/v1
# CSE_MODEL=llama2

# === DeepSeek ===
# CSE_API_KEY=your-deepseek-api-key
# CSE_BASE_URL=https://api.deepseek.com/v1
# CSE_MODEL=deepseek-chat

# === LM Studio ===
# CSE_API_KEY=lm-studio
# CSE_BASE_URL=http://localhost:1234/v1
# CSE_MODEL=your-loaded-model

# === Custom OpenAI-Compatible ===
# CSE_API_KEY=your-api-key
# CSE_BASE_URL=https://your-api-endpoint/v1
# CSE_MODEL=your-model-name